diff --git a/templates/nsis/multiUser.nsh b/templates/nsis/multiUser.nsh
index 3de631b..3f62ce1 100644
--- a/templates/nsis/multiUser.nsh
+++ b/templates/nsis/multiUser.nsh
@@ -11,6 +11,39 @@
 # current Install Mode ("all" or "CurrentUser")
 Var installMode
 
+# /D=<folder> overrides the install folder. As NSIS itself reads it, it is the last
+# argument and is never quoted, so everything after it, spaces included, is the folder.
+# NSIS removes /D= from $CMDLINE, so it is read from the process command line.
+!macro installDirFromCommandLine
+  Push $0
+  Push $1
+  Push $2
+  Push $3
+  System::Call 'kernel32::GetCommandLineW() t .r3'
+  StrLen $2 $3
+  StrCpy $1 0
+  ${DoWhile} $1 < $2
+    StrCpy $0 $3 4 $1
+    ${If} $0 S== " /D="
+      IntOp $1 $1 + 4
+      StrCpy $INSTDIR $3 "" $1
+      ${Do}
+        StrCpy $0 $INSTDIR 1 -1
+        ${If} $0 != " "
+          ${ExitDo}
+        ${endif}
+        StrCpy $INSTDIR $INSTDIR -1
+      ${Loop}
+      ${ExitDo}
+    ${endif}
+    IntOp $1 $1 + 1
+  ${Loop}
+  Pop $3
+  Pop $2
+  Pop $1
+  Pop $0
+!macroend
+
 !ifndef INSTALL_MODE_PER_ALL_USERS
   !ifndef ONE_CLICK
     Var hasPerUserInstallation
@@ -28,23 +61,24 @@ Var installMode
       StrCpy $INSTDIR $perUserInstallationFolder
     ${else}
       StrCpy $0 "$LocalAppData\Programs"
-      System::Store S
-      # Win7 has a per-user programfiles known folder and this can be a non-default location
+      Push $1
+      Push $2
+      # UserProgramFiles is the per-user install root and can be a non-default location
+      StrCpy $2 0
       System::Call 'SHELL32::SHGetKnownFolderPath(g "${FOLDERID_UserProgramFiles}", i ${KF_FLAG_CREATE}, p 0, *p .r2)i.r1'
       ${If} $1 == 0
-        System::Call '*$2(&w${NSIS_MAX_STRLEN} .s)'
-        StrCpy $0 $1
+        System::Call 'KERNEL32::lstrcpynW(w .r0, p r2, i ${NSIS_MAX_STRLEN})p'
+      ${endif}
+      # SHGetKnownFolderPath may return allocated memory even on failure
+      ${If} $2 != 0
         System::Call 'OLE32::CoTaskMemFree(p r2)'
       ${endif}
-      System::Store L
+      Pop $2
+      Pop $1
       StrCpy $INSTDIR "$0\${APP_FILENAME}"
     ${endif}
 
-    # allow /D switch to override installation path https://github.com/electron-userland/electron-builder/issues/1551
-    ${StdUtils.GetParameter} $R0 "D" ""
-    ${If} $R0 != ""
-      StrCpy $INSTDIR $R0
-    ${endif}
+    !insertmacro installDirFromCommandLine
 
   !macroend
 !endif
@@ -83,11 +117,7 @@ Var installMode
       StrCpy $INSTDIR "$0\${APP_FILENAME}"
     ${endif}
 
-    # allow /D switch to override installation path https://github.com/electron-userland/electron-builder/issues/1551
-    ${StdUtils.GetParameter} $R0 "D" ""
-    ${If} $R0 != ""
-      StrCpy $INSTDIR $R0
-    ${endif}
+    !insertmacro installDirFromCommandLine
 
   !macroend
 !endif
diff --git a/templates/nsis/include/extractAppPackage.nsh b/templates/nsis/include/extractAppPackage.nsh
index f5470bf..71e20b2 100644
--- a/templates/nsis/include/extractAppPackage.nsh
+++ b/templates/nsis/include/extractAppPackage.nsh
@@ -1,3 +1,14 @@
+# Shows which stage the install is in, on the line above the progress bar.
+# installSection.nsh turns detail output off for interactive installs, so it is
+# turned on for this one line of text and off again. Silent installs show nothing.
+!macro installStage TEXT
+  ${IfNot} ${Silent}
+    SetDetailsPrint textonly
+    DetailPrint "${TEXT}"
+    SetDetailsPrint none
+  ${endif}
+!macroend
+
 !macro extractEmbeddedAppPackage
   !ifdef COMPRESS
     SetCompress off
@@ -6,6 +17,7 @@
   Var /GLOBAL packageArch
   
   !insertmacro identify_package
+  !insertmacro installStage "Preparing application files..."
   !insertmacro compute_files_for_current_arch
 
   !ifdef COMPRESS
@@ -94,6 +106,7 @@
   CreateDirectory "$PLUGINSDIR\7z-out"
   ClearErrors
   SetOutPath "$PLUGINSDIR\7z-out"
+  !insertmacro installStage "Extracting application files..."
   Nsis7z::Extract "${FILE}"
   Pop $R0
   SetOutPath $R0
@@ -105,6 +118,7 @@
     IntOp $R1 $R1 + 1
 
     # Attempt to copy files in atomic way
+    !insertmacro installStage "Installing application files..."
     CopyFiles /SILENT "$PLUGINSDIR\7z-out\*" $OUTDIR
     IfErrors 0 DoneExtract7za
 
@@ -113,21 +127,12 @@
       # Try copying a few times before asking for a user action.
       Goto RetryExtract7za
     ${else}
-      MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "$(appCannotBeClosed)" /SD IDRETRY IDCANCEL AbortExtract7za
+      MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "${PRODUCT_NAME} could not copy its files to $OUTDIR. Make sure the disk has enough free space and that ${PRODUCT_NAME} is closed, then click Retry." /SD IDCANCEL IDRETRY RetryExtract7za
     ${endIf}
 
-    # As an absolutely last resort after a few automatic attempts and user
-    # intervention - we will just overwrite everything with `Nsis7z::Extract`
-    # even though it is not atomic and will ignore errors.
-
-    # Clear the temporary folder first to make sure we don't use twice as
-    # much disk space.
-    RMDir /r "$PLUGINSDIR\7z-out"
-
-    Nsis7z::Extract "${FILE}"
-    Goto DoneExtract7za
-
-  AbortExtract7za:
+    # Stop rather than extract over the top while ignoring errors: that reports
+    # success with files missing, for example on a full disk.
+    SetErrorLevel 2
     Quit
 
   RetryExtract7za:
