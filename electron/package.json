{
  "name": "celerp",
  "version": "1.0.0",
  "description": "Free business software \u2014 inventory, invoicing, and operations in one place.",
  "main": "main.js",
  "author": "Data Universal Limited",
  "license": "BSL-1.1",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "start": "electron .",
    "dev": "CELERP_DEV_MODE=1 electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "test": "NODE_ENV=development jest --forceExit"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "embedded-postgres": "^17.9.0-beta.16"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^25.0.0",
    "jest": "^30.3.0"
  },
  "build": {
    "appId": "com.celerp.app",
    "productName": "Celerp",
    "copyright": "Copyright \u00a9 2026 Data Universal Limited",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/@embedded-postgres/**"
    ],
    "files": [
      "main.js",
      "restart.js",
      "preload.js",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "app",
        "filter": [
          "celerp/**",
          "default_modules/**",
          "ui/**",
          "alembic/**",
          "alembic.ini",
          "pyproject.toml",
          "MANIFEST.in",
          "!**/__pycache__",
          "!**/*.pyc",
          "!tests/**",
          "!docs/**",
          "!dev.db",
          "!celerp.db",
          "!electron/**",
          "scripts/module_setup.py",
          "!build/**",
          "!dist/**",
          "!*.egg-info/**",
          "!.venv/**"
        ]
      },
      {
        "from": "python-standalone/${os}-${arch}",
        "to": "python"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "Celerp-Setup.exe",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Celerp-mac.dmg",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Office",
      "artifactName": "Celerp.AppImage",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "afterPack": "scripts/after-pack.js",
    "publish": {
      "provider": "github",
      "owner": "celerp",
      "repo": "celerp",
      "releaseType": "release"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
