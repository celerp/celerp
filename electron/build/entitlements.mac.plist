<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron's JS engine (JIT compilation) -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Required for Electron's unsigned memory (V8 code generation) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Required because bundled Python dylibs are not signed by us -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Network access for local API server -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- File access for user data (database, exports) -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
