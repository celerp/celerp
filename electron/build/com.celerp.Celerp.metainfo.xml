      <image>https://raw.githubusercontent.com/celerp/celerp/main/docs/press-kit/screenshots/dashboard.png</image>
      <caption>Dashboard with revenue trend, receivables aging, and inventory mix</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/celerp/celerp/main/docs/press-kit/screenshots/inventory.png</image>
