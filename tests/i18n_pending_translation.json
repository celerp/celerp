  "keys": {
    "migration.export_warning_sage50": {
      "en": "Tick Include Headings on the Options tab of each template before exporting: Celerp recognises every file by its column names.",
      "params": []
    },
    "migration.export_range_sage50_trial_balance": {
      "en": "As of the last day of each fiscal year and of the last transaction, and the day before the first transaction if the books have beginning balances",
      "params": []
    },
    "migration.err_export_damaged": {
      "en": "These {source} files cannot be read: a value in them is not one {source} writes, so they are damaged or were changed after exporting. Nothing was imported. Export the files again from {source} and upload the new ones.",
      "params": [
        "source"
      ]
    },
    "migration.err_sage50_distributions": {
      "en": "{where}: the transaction says it holds {count} lines, but the rows that follow do not hold that many lines of the same transaction. Export the {label} again.",
      "params": [
        "count",
        "label",
        "where"
      ]
    },
    "migration.err_sage50_unbalanced": {
      "en": "{where} does not balance: its lines differ by {difference}. Export the {label} again.",
      "params": [
        "difference",
        "label",
        "where"
      ]
    },
    "migration.err_sage50_contact_missing": {
      "en": "The {label} names IDs the {list} does not list: {ids}. Export the {list} again with inactive records included.",
      "params": [
        "ids",
        "label",
        "list"
      ]
    },
    "migration.err_sage50_tb_last": {
      "en": "No {label} is as of {date}, the date of the last transaction, or later. Add one as of that day.",
      "params": [
        "date",
        "label"
      ]
    },
    "migration.err_sage50_currency": {
      "en": "Choose the currency these books are kept in before importing them.",
      "params": []
    },
    "migration.sage50_currency_question": {
      "en": "Currency these books are kept in",
      "params": []
    },
    "migration.sage50_currency_source": {
      "en": "Company",
      "params": []
    },
    "migration.sage50_employee_note": {
      "en": "Celerp does not keep employee records. Payroll checks are not in Sage 50's exports; the import check shows where they leave the trial balance.",
      "params": []
    },
    "migration.sage50_stock_note": {
      "en": "Sage 50 does not export quantities on hand. The items are imported; count their stock in Celerp after the import.",
      "params": []
    },
    "migration.sage50_tax_unassigned_note": {
      "en": "The lines of these invoices have different Sage 50 tax types, and Sage 50 does not export which tax types are taxable, so each invoice's sales tax is imported as one tax line on it. Its total and its tax total are unchanged.",
      "params": []
    },
    "migration.sage50_absent_general": {
      "en": "No general journal entries are imported. Upload the General Journal if the business made any.",
      "params": []
    },
    "migration.sage50_absent_sales": {
      "en": "No invoice or credit memo history is imported. Upload the Sales Journal if the business invoiced customers.",
      "params": []
    },
    "migration.sage50_absent_receipts": {
      "en": "No receipts are imported, so invoices stay unpaid. Upload the Cash Receipts Journal if the business received money.",
      "params": []
    },
    "migration.sage50_absent_purchases": {
      "en": "No purchase or vendor credit memo history is imported. Upload the Purchase Journal if the business entered purchases.",
      "params": []
    },
    "migration.sage50_absent_payments": {
      "en": "No payments are imported, so purchases stay unpaid. Upload the Cash Disbursements Journal if the business paid money out.",
      "params": []
    },
    "migration.sage50_accepts": {
      "en": "From Sage 50 or Peachtree (US edition, 2010 or later), export and upload together (as the files or one zip): 1. Open File > Select Import/Export. 2. For each template, choose it, select Export, tick Include Headings on the Options tab, set the date range to All, and save the file: the Chart of Accounts List, the Customer List, the Vendor List, the Inventory Item List, the Employee List, and the General, Sales, Cash Receipts, Purchase and Cash Disbursements Journals. 3. In Reports & Forms, export to Excel a General Ledger Trial Balance as of the last day of each fiscal year and of the last transaction (and the day before the first transaction if the books have beginning balances), and the Aged Receivables and Aged Payables reports as of the last transaction. Payroll checks, inventory adjustments and the cost of goods sold Sage 50 posts for stock items are not in these exports; the import check shows where they leave the trial balance.",
      "params": []
    },
